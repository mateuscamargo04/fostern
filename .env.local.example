# Supabase — Fostern
# 1) Crie o projeto em supabase.com
# 2) Dashboard -> Settings -> API
# 3) Copie os dois valores abaixo para um arquivo .env.local (NÃO commite)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Turnstile (Cloudflare) — CAPTCHA
# 1) dash.cloudflare.com -> Turnstile -> Add site
# 2) Copie a SITE KEY (pública) aqui e no Vercel (a SECRET KEY vai no Supabase, não no site)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Stripe — Pagamentos
# 1) dashboard.stripe.com -> Developers -> API keys (modo teste por enquanto)
# 2) STRIPE_SECRET_KEY = sk_test_...
# 3) STRIPE_WEBHOOK_SECRET = whsec_... (gerar depois do deploy: Stripe -> Webhooks -> Endpoint /api/webhook)
# A publishable key (pk_test_) não é usada no checkout redirecionado, só se adotar elementos embutidos.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase SERVICE_ROLE — SÓ para rotas de servidor (checkout, webhook, backup)
# Settings -> API -> service_role. NUNCA expor no cliente. No Vercel, adicionar como variável secreta.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Tutora IA — Assistente com OpenAI
# 1) platform.openai.com -> API keys -> Create new secret key
# 2) Adicione no .env.local (e no Vercel como variável secreta)
# Opcional: OPENAI_BASE_URL para provedores compatíveis (Groq, Mistral) e OPENAI_MODEL (padrão gpt-4o-mini)
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
